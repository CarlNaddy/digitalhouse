@page "/Account/ResetPassword"
@attribute [ExcludeFromInteractiveRouting]

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Reset password</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Reset your password</MudText>

@if (!string.IsNullOrEmpty(_message))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_message</MudAlert>
}

<EditForm Model="Input" method="post" OnValidSubmit="SubmitAsync" FormName="reset-password">
    <DataAnnotationsValidator />
    <input type="hidden" name="Input.Code" value="@Input.Code" />
    <MudGrid Spacing="3">
        <MudItem xs="12">
            <MudText Typo="Typo.body2">Email</MudText>
            <InputText @bind-Value="Input.Email" class="account-input" />
            <ValidationMessage For="@(() => Input.Email)" class="account-validation" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.body2">New password</MudText>
            <InputText @bind-Value="Input.Password" type="password" class="account-input" />
            <ValidationMessage For="@(() => Input.Password)" class="account-validation" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.body2">Confirm password</MudText>
            <InputText @bind-Value="Input.ConfirmPassword" type="password" class="account-input" />
            <ValidationMessage For="@(() => Input.ConfirmPassword)" class="account-validation" />
        </MudItem>
        <MudItem xs="12">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                Reset password
            </MudButton>
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    // BL0008: the initializer only backstops a GET request; a POST always
    // supplies every bound field before OnValidSubmit runs.
#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    private string? _message;

    protected override void OnInitialized()
    {
        if (Code is not null)
        {
            Input.Code = Code;
        }
    }

    private async Task SubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            // Don't reveal that the user doesn't exist.
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Input.Code));
        var result = await UserManager.ResetPasswordAsync(user, code, Input.Password);
        if (result.Succeeded)
        {
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        _message = "Error: " + string.Join(" ", result.Errors.Select(e => e.Description));
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [StringLength(100, MinimumLength = 8)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";

        public string Code { get; set; } = "";
    }
}
