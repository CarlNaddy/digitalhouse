@page "/Account/ForgotPassword"
@attribute [ExcludeFromInteractiveRouting]

@using System.ComponentModel.DataAnnotations
@using System.Text
@using DigitalHouse.Features.Email
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager Nav

<PageTitle>Forgot password</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Forgot your password?</MudText>

@if (_submitted)
{
    <MudAlert Severity="Severity.Success" Class="mb-4">
        If an account with that email exists, we've sent a link to reset your password.
    </MudAlert>
}
else
{
    <EditForm Model="Input" method="post" OnValidSubmit="SubmitAsync" FormName="forgot-password">
        <DataAnnotationsValidator />
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudText Typo="Typo.body2">Email</MudText>
                <InputText @bind-Value="Input.Email" class="account-input" />
                <ValidationMessage For="@(() => Input.Email)" class="account-validation" />
            </MudItem>
            <MudItem xs="12">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                    Send reset link
                </MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
}

<MudText Class="mt-4">
    <MudLink Href="Account/Login">Back to log in</MudLink>
</MudText>

@code {
    // BL0008: the initializer only backstops a GET request; a POST always
    // supplies every bound field before OnValidSubmit runs.
#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    private bool _submitted;

    private async Task SubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);

        // Same message either way — don't reveal whether the address is registered.
        if (user is not null && await UserManager.IsEmailConfirmedAsync(user))
        {
            var code = await UserManager.GeneratePasswordResetTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
            var resetLink = Nav.GetUriWithQueryParameters(
                Nav.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
                new Dictionary<string, object?> { ["code"] = code });
            await EmailSender.SendPasswordResetLinkAsync(user, Input.Email, resetLink);
        }

        _submitted = true;
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
