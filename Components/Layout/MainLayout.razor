@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="_isDarkMode" Theme="AppTheme.Instance" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="quest-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="Toggle navigation" />
        <div class="quest-emblem">
            <MudIcon Icon="@Icons.Material.Filled.Shield" Class="quest-emblem-icon" />
            <MudText Typo="Typo.h6" Class="quest-wordmark">DigitalHouse</MudText>
        </div>
        <MudSpacer />
        <AccountMenu />
        <CultureSelector />
        <MudIconButton Icon="@(_muted ? Icons.Material.Filled.VolumeOff : Icons.Material.Filled.VolumeUp)"
                       Color="Color.Inherit" OnClick="ToggleMuteAsync"
                       aria-label="@(_muted ? "Unmute sound effects" : "Mute sound effects")" />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="@(() => _isDarkMode = !_isDarkMode)"
                       aria-label="Toggle dark mode" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always" Class="quest-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        @* Padding goes on an inner wrapper, not MudMainContent itself — a `pa-*`
           class on MudMainContent overrides the padding-top it uses to clear the
           fixed MudAppBar, hiding the top of every page. *@
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MudThemeProvider _themeProvider = null!;
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private bool _muted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = await _themeProvider.GetSystemDarkModeAsync();
            _muted = await JS.InvokeAsync<bool>("gameFx.isMuted");
            await JS.InvokeVoidAsync("gameFx.attach");
            StateHasChanged();
        }
    }

    private async Task ToggleMuteAsync()
    {
        _muted = !_muted;
        await JS.InvokeVoidAsync("gameFx.setMuted", _muted);
    }
}
