@* Rendered to an HTML string by RazorEmailRenderer — see ConfirmationEmail.razor. *@

<h2>Reset your password</h2>
<p>Someone requested a password reset for this account. If that was you, click below:</p>
<p><a href="@Link">Reset password</a></p>
<p>If the link doesn't work, copy this URL into your browser:</p>
<p>@Link</p>
<p>If you didn't request this, you can safely ignore this email.</p>

@code {
    [Parameter, EditorRequired] public string Link { get; set; } = "";
}
