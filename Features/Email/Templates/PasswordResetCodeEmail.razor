@* Rendered to an HTML string by RazorEmailRenderer — see ConfirmationEmail.razor.
   Implemented for IEmailSender<TUser> interface completeness (the code-entry
   reset flow, e.g. for API/mobile clients); this app's own UI uses the
   link-based flow (PasswordResetEmail.razor) via ForgotPassword.razor. *@

<h2>Your password reset code</h2>
<p>Use this code to reset your password:</p>
<p style="font-size:1.5em;font-weight:bold;letter-spacing:0.1em;">@Code</p>
<p>If you didn't request this, you can safely ignore this email.</p>

@code {
    [Parameter, EditorRequired] public string Code { get; set; } = "";
}
