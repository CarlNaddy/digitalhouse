@* Rendered to an HTML string by RazorEmailRenderer — not a routable page, no
   @page directive, no app layout. Parity plan P4.2's worked email template. *@

<h2>Confirm your email</h2>
<p>Thanks for registering. Confirm your email address to finish setting up your account:</p>
<p><a href="@Link">Confirm email</a></p>
<p>If the link doesn't work, copy this URL into your browser:</p>
<p>@Link</p>

@code {
    [Parameter, EditorRequired] public string Link { get; set; } = "";
}
